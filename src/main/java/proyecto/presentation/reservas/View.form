          </component>
          <component id="lcategorias" class="javax.swing.JLabel">
            <constraints><grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
            <properties><text value="Categorías requeridas (selección múltiple)"/></properties>
