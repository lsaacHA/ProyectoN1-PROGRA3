<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="proyecto.presentation.estadisticas.View">
  <grid id="root" binding="panel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="true" same-size-vertically="false" hgap="14" vgap="14">
    <margin top="14" left="14" bottom="14" right="14"/>
    <constraints><xy x="20" y="20" width="1180" height="650"/></constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="recursos" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="10">
        <margin top="10" left="10" bottom="10" right="10"/>
        <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints>
        <properties/><border type="etched" title="Recursos"/>
        <children>
          <grid id="filtroRecursos" layout-manager="GridLayoutManager" row-count="2" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="8">
            <margin top="8" left="8" bottom="8" right="8"/>
            <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
            <properties/><border type="etched" title="Fechas desde y hasta"/>
            <children>
              <component id="rdl" class="javax.swing.JLabel"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Desde"/></properties></component>
              <component id="rd" class="com.github.lgooddatepicker.components.DatePicker" binding="recursosDesdeFld" custom-create="true"><constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
              <component id="rhl" class="javax.swing.JLabel"><constraints><grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Hasta"/></properties></component>
              <component id="rh" class="com.github.lgooddatepicker.components.DatePicker" binding="recursosHastaFld" custom-create="true"><constraints><grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
              <grid id="rb" layout-manager="FlowLayout" hgap="8" vgap="0" flow-align="2"><constraints><grid row="1" column="0" row-span="1" col-span="4" vsize-policy="3" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/><border type="none"/><children>
                <component id="rc" class="javax.swing.JButton" binding="cargarRecursosFld"><constraints/><properties><icon value="proyecto/presentation/icons/check.png"/><text value="Cargar"/></properties></component>
                <component id="ri" class="javax.swing.JButton" binding="imprimirRecursosFld"><constraints/><properties><icon value="proyecto/presentation/icons/pdf.png"/><text value="Imprimir"/></properties></component>
              </children></grid>
            </children>
          </grid>
          <scrollpane id="rt"><constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"><preferred-size width="530" height="170"/></grid></constraints><properties/><border type="etched" title="Resultados"/><children><component id="rtable" class="javax.swing.JTable" binding="recursosFld"><constraints/><properties/></component></children></scrollpane>
          <grid id="rg" binding="graficoRecursosFld" layout-manager="BorderLayout" hgap="0" vgap="0"><constraints><grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"><preferred-size width="530" height="300"/></grid></constraints><properties/><border type="etched" title="Gráfico"/><children/></grid>
        </children>
      </grid>
      <grid id="actividades" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="10">
        <margin top="10" left="10" bottom="10" right="10"/>
        <constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints>
        <properties/><border type="etched" title="Actividades"/>
        <children>
          <grid id="filtroActividades" layout-manager="GridLayoutManager" row-count="2" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="8">
            <margin top="8" left="8" bottom="8" right="8"/>
            <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints>
            <properties/><border type="etched" title="Fechas desde y hasta"/>
            <children>
              <component id="adl" class="javax.swing.JLabel"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Desde"/></properties></component>
              <component id="ad" class="com.github.lgooddatepicker.components.DatePicker" binding="actividadesDesdeFld" custom-create="true"><constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
              <component id="ahl" class="javax.swing.JLabel"><constraints><grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Hasta"/></properties></component>
              <component id="ah" class="com.github.lgooddatepicker.components.DatePicker" binding="actividadesHastaFld" custom-create="true"><constraints><grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
              <grid id="ab" layout-manager="FlowLayout" hgap="8" vgap="0" flow-align="2"><constraints><grid row="1" column="0" row-span="1" col-span="4" vsize-policy="3" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/><border type="none"/><children>
                <component id="ac" class="javax.swing.JButton" binding="cargarActividadesFld"><constraints/><properties><icon value="proyecto/presentation/icons/check.png"/><text value="Cargar"/></properties></component>
                <component id="ai" class="javax.swing.JButton" binding="imprimirActividadesFld"><constraints/><properties><icon value="proyecto/presentation/icons/pdf.png"/><text value="Imprimir"/></properties></component>
              </children></grid>
            </children>
          </grid>
          <scrollpane id="at"><constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"><preferred-size width="530" height="170"/></grid></constraints><properties/><border type="etched" title="Resultados"/><children><component id="atable" class="javax.swing.JTable" binding="actividadesFld"><constraints/><properties/></component></children></scrollpane>
          <grid id="ag" binding="graficoActividadesFld" layout-manager="BorderLayout" hgap="0" vgap="0"><constraints><grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"><preferred-size width="530" height="300"/></grid></constraints><properties/><border type="etched" title="Gráfico"/><children/></grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
