<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="proyecto.presentation.recursos.View">
  <grid id="root" binding="panel" layout-manager="GridLayoutManager" row-count="3" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="14">
    <margin top="14" left="14" bottom="14" right="14"/>
    <constraints><xy x="20" y="20" width="900" height="560"/></constraints>
    <properties/>
    <border type="none"/>
    <children>
      <hspacer id="left"><constraints><grid row="0" column="0" row-span="2" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints></hspacer>
      <hspacer id="right"><constraints><grid row="0" column="2" row-span="2" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints></hspacer>
      <grid id="filter" binding="filtroPanel" layout-manager="GridLayoutManager" row-count="1" column-count="6" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="8">
        <margin top="9" left="9" bottom="9" right="9"/>
        <constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"><preferred-size width="760" height="70"/></grid></constraints>
        <properties/><border type="etched" title="Filtro"/>
        <children>
          <component id="fl1" class="javax.swing.JLabel"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Categoría"/></properties></component>
          <component id="fc1" class="javax.swing.JComboBox" binding="categoriaFiltroFld"><constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"><preferred-size width="190" height="-1"/></grid></constraints><properties/></component>
          <component id="fl2" class="javax.swing.JLabel"><constraints><grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Descripción"/></properties></component>
          <component id="ft1" class="javax.swing.JTextField" binding="descripcionFiltroFld"><constraints><grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"><preferred-size width="210" height="-1"/></grid></constraints><properties/></component>
          <component id="fb1" class="javax.swing.JButton" binding="buscarFld"><constraints><grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><icon value="proyecto/presentation/icons/search.png"/><text value="Buscar"/></properties></component>
          <component id="fb2" class="javax.swing.JButton" binding="imprimirFld"><constraints><grid row="0" column="5" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><icon value="proyecto/presentation/icons/pdf.png"/><text value="Imprimir"/></properties></component>
        </children>
      </grid>
      <grid id="editor" binding="recursoPanel" layout-manager="GridLayoutManager" row-count="4" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="8">
        <margin top="12" left="12" bottom="12" right="12"/>
        <constraints><grid row="1" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"><preferred-size width="530" height="205"/></grid></constraints>
        <properties/><border type="etched" title="Recurso"/>
        <children>
          <component id="el1" class="javax.swing.JLabel"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="ID"/></properties></component>
          <component id="et1" class="javax.swing.JTextField" binding="idFld"><constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"><preferred-size width="370" height="-1"/></grid></constraints><properties/></component>
          <component id="el2" class="javax.swing.JLabel"><constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Categoría"/></properties></component>
          <component id="ec1" class="javax.swing.JComboBox" binding="categoriaFld"><constraints><grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
          <component id="el3" class="javax.swing.JLabel"><constraints><grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Descripción"/></properties></component>
          <component id="et2" class="javax.swing.JTextField" binding="descripcionFld"><constraints><grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
          <grid id="buttons" layout-manager="FlowLayout" hgap="10" vgap="5" flow-align="2">
            <constraints><grid row="3" column="0" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/><border type="none"/>
            <children>
              <component id="eb1" class="javax.swing.JButton" binding="guardarFld"><constraints/><properties><icon value="proyecto/presentation/icons/save.png"/><text value="Guardar"/></properties></component>
              <component id="eb2" class="javax.swing.JButton" binding="borrarFld"><constraints/><properties><enabled value="false"/><icon value="proyecto/presentation/icons/delete.png"/><text value="Borrar"/></properties></component>
              <component id="eb3" class="javax.swing.JButton" binding="limpiarFld"><constraints/><properties><icon value="proyecto/presentation/icons/clear.png"/><text value="Limpiar"/></properties></component>
            </children>
          </grid>
        </children>
      </grid>
      <grid id="listPanel" binding="listadoPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints><grid row="2" column="0" row-span="1" col-span="3" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"><preferred-size width="850" height="240"/></grid></constraints>
        <properties/><border type="etched" title="Listado"/>
        <children>
          <scrollpane id="scroll"><constraints border-constraint="Center"/><properties/><border type="none"/><children><component id="table" class="javax.swing.JTable" binding="recursosFld"><constraints/><properties/></component></children></scrollpane>
        </children>
      </grid>
    </children>
  </grid>
</form>
