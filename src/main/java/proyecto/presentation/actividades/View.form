<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="proyecto.presentation.actividades.View">
  <grid id="27dc6" binding="panel" layout-manager="GridLayoutManager" row-count="2" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="14">
    <margin top="14" left="14" bottom="14" right="14"/>
    <constraints>
      <xy x="20" y="20" width="1180" height="650"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <hspacer id="leftSpacer">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>
      <hspacer id="rightSpacer">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>
      <grid id="semana" binding="semanaPanel" layout-manager="GridLayoutManager" row-count="1" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="8">
        <margin top="10" left="10" bottom="10" right="10"/>
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="700" height="75"/>
          </grid>
        </constraints>
        <properties/>
        <border type="etched" title="Semana"/>
        <children>
          <component id="fechaLabel" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Fecha de referencia"/>
            </properties>
          </component>
          <component id="fecha" class="com.github.lgooddatepicker.components.DatePicker" binding="fechaFld" custom-create="true">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="210" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="cargar" class="javax.swing.JButton" binding="cargarFld">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          <properties>
            <icon value="proyecto/presentation/icons/check.png"/>
            <text value="Cargar"/>
          </properties>
          </component>
          <component id="imprimir" class="javax.swing.JButton" binding="imprimirFld">
            <constraints>
              <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          <properties>
            <icon value="proyecto/presentation/icons/pdf.png"/>
            <text value="Imprimir"/>
          </properties>
          </component>
        </children>
      </grid>
      <scrollpane id="actividadesScroll">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="3" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="1150" height="520"/>
          </grid>
        </constraints>
        <properties/>
        <border type="etched" title="Actividades semanales"/>
        <children>
          <component id="tabla" class="javax.swing.JTable" binding="actividadesFld">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
